<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navinet_locmap_launch</name>
  <version>1.0.0</version>
  <description>Launch files and configurations for NaviNet LocMap system</description>
  <maintainer email="navinet@example.com">NaviNet Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mid360_driver</depend>
  <depend>hikvision_camera_driver</depend>
  <depend>third_party_camera_driver</depend>
  <depend>stm32_sync_driver</depend>
  <depend>data_sync_recorder</depend>
  <depend>rviz2</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
